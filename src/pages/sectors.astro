---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ClientList from '../components/ClientList.astro';
import { sectors, facilityManagementLine } from '../data/sectors';
import { getService } from '../data/services';
---

<Base
  title="Sectors we serve | Phoenix Decorators"
  description="Waterproofing, painting, sealants and glass cleaning for hotels, hospitals, offices, residential towers, public buildings and industry across Sri Lanka."
>
  <PageHero
    title="Sectors we serve."
    lead="Specialist building care for hotels, hospitals, offices, residences, public buildings and industry."
  />

  {
    sectors.map((sector, i) => (
      <section
        id={sector.slug}
        class:list={['sector section', i % 2 === 0 ? 'bg-mist' : 'bg-paper']}
        aria-labelledby={`${sector.slug}-heading`}
      >
        <div class="container-site grid gap-10 md:gap-12 lg:grid-cols-12 lg:gap-10">
          <figure class:list={['lg:col-span-6', i % 2 === 1 && 'lg:order-2 lg:col-start-7']}>
            <div class="lg:sticky lg:top-[calc(var(--header-h)+48px)]">
              <div class="media-reveal overflow-hidden rounded-[var(--radius-card-sm)] bg-night md:rounded-[var(--radius-card)]">
                <Picture
                  src={sector.photo.src}
                  alt={sector.photo.alt}
                  formats={['avif', 'webp']}
                  widths={[400, 640, 960, 1280]}
                  sizes="(min-width: 1376px) 630px, (min-width: 1024px) 46vw, (min-width: 768px) calc(100vw - 96px), calc(100vw - 48px)"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  decoding="async"
                  class="aspect-[4/3] h-auto w-full object-cover"
                  style={sector.photo.position ? `object-position: ${sector.photo.position};` : undefined}
                />
              </div>
              <figcaption class="mt-3 text-[15px] text-graphite">{sector.photo.caption}</figcaption>
            </div>
          </figure>

          <div
            class:list={[
              'grid gap-10 md:grid-cols-12 lg:col-span-5 lg:grid-cols-1',
              i % 2 === 1 ? 'lg:order-1 lg:col-start-1' : 'lg:col-start-8',
            ]}
          >
            <div class="md:col-span-6 lg:col-span-1">
              <h2 id={`${sector.slug}-heading`} class="t-h2 text-balance">
                {sector.name}.
              </h2>
              <p class="t-lead mt-6 text-graphite">{sector.intro}</p>
              <h3 class="mt-10 text-[17px] font-semibold text-ink">Services</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {sector.services.map((slug) => {
                  const service = getService(slug);
                  return service ? (
                    <li>
                      <a href={`/services/${slug}`} class:list={['pill', i % 2 === 0 && 'on-mist']}>
                        {service.name}
                      </a>
                    </li>
                  ) : null;
                })}
              </ul>
            </div>
            <div class="md:col-span-6 lg:col-span-1">
              <h3 class="text-[17px] font-semibold text-ink">Clients include</h3>
              <ClientList names={sector.clients} label={`${sector.name} clients`} class="mt-4" />
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <section class:list={['py-16 md:py-24', sectors.length % 2 === 0 ? 'bg-mist' : 'bg-paper']}>
    <div class="container-site">
      <p class="t-h3 text-column text-balance text-ink">{facilityManagementLine}</p>
    </div>
  </section>
</Base>

<style>
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 18px;
    border-radius: 999px;
    background: var(--color-paper);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
    font-size: 15px;
    font-weight: 500;
    color: var(--color-ink);
    transition:
      box-shadow 300ms var(--ease),
      color 300ms var(--ease),
      transform 150ms var(--ease);
  }

  .pill:hover {
    color: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }

  .pill.on-mist:hover {
    color: var(--color-brand-ink);
    box-shadow: inset 0 0 0 1px var(--color-brand-ink);
  }

  .pill:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .pill:active {
      transform: none;
    }
  }
</style>
