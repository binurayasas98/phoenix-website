---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import TwoToneHeading from '../components/TwoToneHeading.astro';
import OverlayCard from '../components/OverlayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TextLink from '../components/TextLink.astro';
import DirectorCard from '../components/DirectorCard.astro';
import Rail from '../components/Rail.astro';
import IntroStatement from '../components/home/IntroStatement.astro';
import ServicesRail from '../components/home/ServicesRail.astro';
import WhyPhoenix from '../components/home/WhyPhoenix.astro';
import heroImg from '../assets/images/hero.jpg';
import { site, whatsappUrl } from '../data/site';
import { accessMethods } from '../data/services';
import { getProject, type Project } from '../data/projects';
import { trustedBy } from '../data/clients';
import { directors } from '../data/directors';
import { sectors, facilityManagementLine } from '../data/sectors';
import { testimonials } from '../data/testimonials';

const facts = [
  `${site.projectsCompleted}+ projects since ${site.since}`,
  `CIDA ${site.cidaGrade} registered`,
  'Fully insured',
  site.warranty.short,
];

const bySlug = (slug: string) => getProject(slug) as Project;
const gridProjects = ['shangri-la', 'world-trade-center', 'one-galle-face', 'aitken-spence', 'hemas-hospitals', 'bia'].map(bySlug);

const shownTestimonials = testimonials.filter((t) => t.permissionConfirmed);

// Keep hyphenated names like "Shangri-La" on one line.
const nb = (text: string) => text.replace(/-/g, '‑');
---

<Base
  title="Waterproofing, Painting and Glass Cleaning in Colombo | Phoenix Decorators"
  description="Waterproofing, painting, sealants and glass cleaning for commercial and residential buildings. CIDA SP2 registered, fully insured, 350+ projects since 2011."
  transparentHeader
>
  <PhotoHero
    image={{ src: heroImg, alt: 'Phoenix rope access technician applying sealant to a building facade' }}
    position="58% 70%"
    positionMobile="54% center"
    lines={['Waterproofing and', 'facade specialists.']}
    subline="Waterproofing, painting, sealants and glass cleaning at any height. Trusted at Bandaranaike International Airport, Shangri-La and One Galle Face."
    facts={facts}
    announcement
    rope
    entrance
    home
  />

  <!-- Trusted by, with the facts strip on top on mobile (on desktop the facts sit inside the hero) -->
  <section class="bg-paper" aria-labelledby="trusted-heading">
    <ul class="container-site facts-sm grid grid-cols-2 py-2 md:hidden" aria-label="Key facts">
      {facts.map((f) => <li>{f}</li>)}
    </ul>
    <div class="trusted container-site">
      <h2 id="trusted-heading" class="text-[17px] font-semibold text-ink">Trusted on landmark sites across Sri Lanka.</h2>
      <ul class="mt-5 grid grid-cols-2 gap-x-4 md:mt-8 md:grid-cols-4 md:gap-x-8">
        {
          trustedBy.map((c) => (
            <li class="border-t border-hairline py-3 md:pb-6 md:pt-4">
              <span class="block text-[16px] font-semibold leading-snug tracking-[-0.01em] text-ink md:text-[19px]">{nb(c.name)}</span>
              <span class="mt-0.5 block text-[13px] text-graphite md:mt-1 md:text-[14px]">{c.type}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <IntroStatement />

  <ServicesRail />

  <WhyPhoenix />

  <!-- Access (night) -->
  <section class="access-section section on-night bg-night text-white" aria-labelledby="access-heading" data-track-area="access">
    <div class="container-site">
      <div class="max-w-[960px]">
        <TwoToneHeading id="access-heading" first="Any height." second="The right access." tone="night" />
        <p class="t-lead mt-4 max-w-[40ch] text-white/70 md:mt-6">
          We choose the safest, most efficient way to reach every surface, with strict safety protocols on every job.
        </p>
      </div>
    </div>
    <Rail id="access-rail" label="Access methods" size="access" tone="night" class="mt-8 md:mt-16">
      {
        accessMethods.map((m) => (
          <li>
            <OverlayCard
              image={m.image}
              title={m.name}
              text={m.text}
              sizes="(min-width: 1024px) 360px, (min-width: 768px) 44vw, 78vw"
            />
          </li>
        ))
      }
    </Rail>
    <div class="container-site mt-4 md:mt-8">
      <TextLink href={whatsappUrl(site.whatsappMessages.access)} tone="night" external>
        Ask about access for your building
      </TextLink>
    </div>
  </section>

  <!-- Projects -->
  <section class="projects-section section bg-paper" aria-labelledby="projects-heading">
    <div class="container-site">
      <TwoToneHeading
        id="projects-heading"
        first="Proven on demanding sites."
        second="Selected work for hotels, banks, hospitals and landmark towers."
        class="max-w-[20em]"
      />
    </div>

    <Rail id="projects-rail" label="Projects" size="projects" gridFromTablet class="project-grid mt-8 md:mt-16">
      {
        gridProjects.map((p) => (
          <li>
            <ProjectCard
              project={p}
              href={`/projects#${p.slug}`}
              aspectClass="aspect-[4/5] md:aspect-[4/3]"
              sizes="(min-width: 1376px) 413px, (min-width: 1024px) 30vw, (min-width: 768px) 50vw, min(82vw, 360px)"
              clampScope
              class="h-full"
            />
          </li>
        ))
      }
    </Rail>

    <div class="container-site">
      <div class="mt-10 grid gap-2 md:mt-16 md:grid-cols-12 md:gap-10">
        <p class="text-[21px] font-semibold tracking-[-0.015em] text-ink md:col-span-5 md:text-[24px]">
          Trusted for ongoing contracts.
        </p>
        <p class="text-[17px] text-graphite md:col-span-7 md:text-[19px]">
          Monthly at Shangri&#8209;La. Every three months at the Civil Aviation Authority. Annually at the World Trade Center.
        </p>
      </div>
      <div class="mt-3 md:mt-6">
        <TextLink href="/projects">View all projects</TextLink>
      </div>
    </div>
  </section>

  <!-- Directors -->
  <section class="section bg-mist" aria-labelledby="directors-heading">
    <div class="container-site grid gap-8 md:gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-[calc(var(--header-h)+48px)]">
          <TwoToneHeading id="directors-heading" first={'Led by our\u00a0directors.'} second="Hands-on, on every project." />
          <p class="mt-4 max-w-[44ch] text-[17px] text-graphite md:mt-6">
            Our founder, Christy Marcelline, started Phoenix Decorators in 2011 and runs it today with our co-owner, Ranga
            Gamachchi. Together with a dedicated supervisor, they personally oversee every project we take on.
          </p>
          <div class="mt-2 md:mt-4">
            <TextLink href="/about#leadership" tone="mist">Meet our leadership</TextLink>
          </div>
        </div>
      </div>
      <ul class="lg:col-span-7">
        {
          directors.map((d, i) => (
            <li class:list={[i > 0 && 'mt-7 border-t border-hairline pt-7 md:mt-10 md:pt-10']}>
              <DirectorCard director={d} variant="compact" />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Sectors -->
  <section class="section bg-paper" aria-labelledby="sectors-heading">
    <div class="container-site">
      <TwoToneHeading id="sectors-heading" first="Sectors we serve." second="The same standard in every building." />
      <ul class="mt-8 border-b border-hairline md:mt-16">
        {
          sectors.map((s) => (
            <li class="border-t border-hairline">
              <a href={`/sectors#${s.slug}`} class="sector-row">
                <span class="sector-name">{s.name}</span>
                <span class="sector-clients">{s.clients.slice(0, 3).map(nb).join(', ')}</span>
                <span class="sector-arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-6 max-w-[56ch] text-[17px] text-graphite">{facilityManagementLine}</p>
    </div>
  </section>

  {
    shownTestimonials.length > 0 && (
      <section class="section bg-mist" aria-labelledby="testimonials-heading">
        <div class="container-site">
          <h2 id="testimonials-heading" class="t-h2">What our clients say.</h2>
          <div class="mt-8 grid gap-10 md:mt-16 md:grid-cols-2 md:gap-10">
            {shownTestimonials.map((t) => (
              <figure class="border-t border-hairline pt-8">
                <blockquote>
                  <p class="text-[clamp(22px,2vw,28px)] font-semibold leading-snug tracking-[-0.015em] text-ink">
                    “{t.quote}”
                  </p>
                </blockquote>
                <figcaption class="mt-6">
                  <span class="block font-semibold text-ink">{t.name}</span>
                  <span class="block text-[15px] text-graphite">
                    {t.role}, {t.company}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

</Base>

<style>
  /* Access cards are 360px wide on desktop, so their type steps down a little. */
  @media (min-width: 1024px) {
    .access-section :global(.rail h3) {
      font-size: 24px;
    }

    .access-section :global(.rail p) {
      font-size: 15px;
    }
  }

  /* Home rhythm: 64px sections on mobile, 112px on desktop. Every heading balances its lines. */
  @media (min-width: 768px) {
    :global(#main) {
      --section-y: 112px;
    }
  }

  :global(#main) :global(:is(h1, h2, h3)) {
    text-wrap: balance;
  }

  /* Mobile fact strip: 2 x 2 with hairline dividers */
  .facts-sm li {
    display: flex;
    align-items: center;
    min-height: 56px;
    padding: 12px 16px 12px 0;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }

  .facts-sm li:nth-child(even) {
    padding-left: 16px;
    border-left: 1px solid var(--color-hairline);
  }

  .facts-sm li:nth-child(n + 3) {
    border-top: 1px solid var(--color-hairline);
  }

  /* The fact strip and the trusted grid share one band: no double padding between them. */
  .trusted {
    padding-block: 32px 48px;
  }

  @media (min-width: 768px) {
    .trusted {
      padding-block: 80px 56px;
    }
  }

  /* Project cards in the grid step their titles down a little on desktop. */
  @media (min-width: 1024px) {
    .projects-section :global(.project-grid h3) {
      font-size: 24px;
    }
  }

  /* Sector rows */
  .sector-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'name arrow'
      'clients arrow';
    column-gap: 16px;
    align-items: center;
    min-height: 44px;
    padding-block: 16px;
    color: var(--color-ink);
  }

  .sector-name {
    grid-area: name;
    font-size: clamp(21px, 2.2vw, 30px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    transition: color 300ms var(--ease);
  }

  .sector-clients {
    grid-area: clients;
    margin-top: 4px;
    font-size: 14px;
    color: var(--color-graphite);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .sector-arrow {
    grid-area: arrow;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1;
    color: var(--color-graphite);
    transition:
      transform 300ms var(--ease),
      color 300ms var(--ease);
  }

  .sector-row:hover .sector-name,
  .sector-row:hover .sector-arrow {
    color: var(--color-brand);
  }

  .sector-row:hover .sector-arrow {
    transform: translateX(4px);
  }

  @media (min-width: 1024px) {
    .sector-row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) auto;
      grid-template-areas: 'name clients arrow';
      column-gap: 40px;
      padding-block: 22px;
    }

    .sector-clients {
      margin-top: 0;
      font-size: 15px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-row:hover .sector-arrow {
      transform: none;
    }
  }
</style>
