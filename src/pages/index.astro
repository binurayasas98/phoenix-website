---
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import TwoToneHeading from '../components/TwoToneHeading.astro';
import OverlayCard from '../components/OverlayCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TextLink from '../components/TextLink.astro';
import DirectorCard from '../components/DirectorCard.astro';
import Faq from '../components/Faq.astro';
import IntroStatement from '../components/home/IntroStatement.astro';
import ServicesRail from '../components/home/ServicesRail.astro';
import WhyPhoenix from '../components/home/WhyPhoenix.astro';
import Process from '../components/home/Process.astro';
import heroImg from '../assets/images/hero.jpg';
import { site, whatsappUrl } from '../data/site';
import { accessMethods } from '../data/services';
import { featuredProjects } from '../data/projects';
import { trustedBy } from '../data/clients';
import { directors } from '../data/directors';
import { sectors, facilityManagementLine } from '../data/sectors';
import { homeFaqs } from '../data/faqs';
import { testimonials } from '../data/testimonials';

const facts = [
  `${site.projectsCompleted}+ projects since ${site.since}`,
  `CIDA ${site.cidaGrade} registered`,
  'Fully insured',
  site.warranty.short,
];
const [firstProjects, restProjects] = [featuredProjects.slice(0, 2), featuredProjects.slice(2)];
const shownTestimonials = testimonials.filter((t) => t.permissionConfirmed);
---

<Base
  title="Waterproofing, Painting and Glass Cleaning in Colombo | Phoenix Decorators"
  description="Waterproofing, painting, sealants and glass cleaning for commercial and residential buildings. CIDA SP2 registered, fully insured, 350+ projects since 2011."
  transparentHeader
>
  <PhotoHero
    image={{ src: heroImg, alt: 'Phoenix rope access technician applying sealant to a building facade' }}
    position="58% center"
    lines={['Waterproofing and', 'facade specialists.']}
    subline="Trusted at Bandaranaike International Airport, Shangri-La and One Galle Face. We waterproof, paint, seal and clean commercial and residential buildings at any height."
    facts={facts}
    announcement
    rope
    entrance
  />

  <!-- Trusted by -->
  <section class="bg-paper pb-16 pt-20 md:pb-24 md:pt-28" aria-labelledby="trusted-heading">
    <div class="container-site">
      <h2 id="trusted-heading" class="text-[17px] font-semibold text-ink">Trusted on landmark sites.</h2>
      <ul class="mt-6 flex flex-wrap gap-x-8 gap-y-3 md:mt-8 md:gap-x-12 md:gap-y-4">
        {
          trustedBy.map((name) => (
            <li class="text-[19px] font-medium tracking-[-0.01em] text-graphite md:text-[24px]">{name}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <IntroStatement />

  <ServicesRail />

  <!-- Access (night) -->
  <section class="section on-night bg-night text-white" aria-labelledby="access-heading" data-track-area="access">
    <div class="container-site">
      <div class="max-w-[960px]">
        <TwoToneHeading id="access-heading" first="Any height." second="The right access." tone="night" />
        <p class="t-lead mt-6 max-w-[40ch] text-white/70">
          We choose the safest, most efficient way to reach every surface, with strict safety protocols on every job.
        </p>
      </div>
    </div>
    <ul class="access-row no-scrollbar mt-12 md:mt-16">
      {
        accessMethods.map((m) => (
          <li class="access-item">
            <OverlayCard
              image={m.image}
              title={m.name}
              text={m.text}
              sizes="(min-width: 1024px) 304px, (min-width: 640px) 50vw, 78vw"
            />
          </li>
        ))
      }
    </ul>
    <div class="container-site mt-8">
      <TextLink href={whatsappUrl(site.whatsappMessages.access)} tone="night" external>
        Ask about access for your building
      </TextLink>
    </div>
  </section>

  <!-- Projects -->
  <section class="section bg-paper" aria-labelledby="projects-heading">
    <div class="container-site">
      <TwoToneHeading
        id="projects-heading"
        first="Proven on demanding sites."
        second="From the international airport to Colombo's landmark towers."
        class="max-w-[22ch]"
      />
      <div class="mt-12 grid gap-4 md:mt-16 md:gap-5 lg:grid-cols-2">
        {firstProjects.map((p) => <ProjectCard project={p} size="large" href={`/projects#${p.slug}`} />)}
      </div>
      <div class="mt-4 grid gap-4 md:mt-5 md:grid-cols-2 md:gap-5 lg:grid-cols-4">
        {restProjects.map((p) => <ProjectCard project={p} href={`/projects#${p.slug}`} />)}
      </div>
      <div class="mt-12 grid gap-4 border-t border-hairline pt-8 md:mt-16 md:grid-cols-12 md:gap-10 md:pt-10">
        <p class="text-[21px] font-semibold tracking-[-0.015em] text-ink md:col-span-5 md:text-[24px]">
          Trusted for ongoing contracts.
        </p>
        <p class="text-[17px] text-graphite md:col-span-7 md:text-[19px]">
          Monthly at Shangri&#8209;La. Every three months at the Civil Aviation Authority. Annually at the World Trade Center.
        </p>
      </div>
      <div class="mt-6">
        <TextLink href="/projects">View all projects</TextLink>
      </div>
    </div>
  </section>


  <!-- Directors -->
  <section class="section bg-mist" aria-labelledby="directors-heading">
    <div class="container-site">
      <TwoToneHeading id="directors-heading" first="Led by its directors." second="Hands-on, on every project." />
      <div class="mt-12 grid gap-16 md:mt-16 md:grid-cols-2 md:gap-10 lg:gap-16">
        {directors.map((d) => <DirectorCard director={d} />)}
      </div>
      <div class="mt-10">
        <TextLink href="/about#leadership" tone="mist">Read their full statements</TextLink>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section class="section bg-paper" aria-labelledby="sectors-heading">
    <div class="container-site">
      <TwoToneHeading
        id="sectors-heading"
        first="Sectors we serve."
        second="Hotels, hospitals, offices, residences, public buildings and industry."
        class="max-w-[24ch]"
      />
      <ul class="mt-12 border-b border-hairline md:mt-16">
        {
          sectors.map((s) => (
            <li class="border-t border-hairline">
              <a href={`/sectors#${s.slug}`} class="sector-row">
                <span class="sector-name">{s.name}</span>
                <span class="sector-arrow" aria-hidden="true">›</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 max-w-[56ch] text-[17px] text-graphite">{facilityManagementLine}</p>
    </div>
  </section>

  <Process tone="mist" />

  {
    shownTestimonials.length > 0 && (
      <section class="section bg-paper" aria-labelledby="testimonials-heading">
        <div class="container-site">
          <h2 id="testimonials-heading" class="t-h2">What our clients say.</h2>
          <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-2 md:gap-10">
            {shownTestimonials.map((t) => (
              <figure class="border-t border-hairline pt-8">
                <blockquote>
                  <p class="text-[clamp(22px,2vw,28px)] font-semibold leading-snug tracking-[-0.015em] text-ink">
                    “{t.quote}”
                  </p>
                </blockquote>
                <figcaption class="mt-6">
                  <span class="block font-semibold text-ink">{t.name}</span>
                  <span class="block text-[15px] text-graphite">
                    {t.role}, {t.company}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Common questions -->
  <section class="section bg-paper" aria-labelledby="faq-heading">
    <div class="container-site grid gap-12 md:grid-cols-12 md:gap-10">
      <div class="md:col-span-5">
        <h2 id="faq-heading" class="t-h2">Common questions.</h2>
      </div>
      <div class="md:col-span-7">
        <Faq items={homeFaqs} />
      </div>
    </div>
  </section>
</Base>

<style>
  .access-row {
    --gutter: max(var(--pad), calc((100% - var(--max)) / 2));
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding-inline: var(--gutter);
  }

  .access-item {
    flex: none;
    width: 78vw;
    scroll-snap-align: start;
  }

  @media (min-width: 640px) {
    .access-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      overflow: visible;
      max-width: calc(var(--max) + var(--pad) * 2);
      margin-inline: auto;
      padding-inline: var(--pad);
    }

    .access-item {
      width: auto;
    }
  }

  @media (min-width: 768px) {
    .access-row {
      gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .access-row {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .access-row :global(h3) {
      font-size: 24px;
    }

    .access-row :global(p) {
      font-size: 15px;
    }
  }

  .sector-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 44px;
    padding-block: 20px;
    color: var(--color-ink);
    transition: color 300ms var(--ease);
  }

  .sector-name {
    font-size: clamp(21px, 2.2vw, 32px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .sector-arrow {
    flex: none;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    color: var(--color-graphite);
    transition:
      transform 300ms var(--ease),
      color 300ms var(--ease);
  }

  .sector-row:hover {
    color: var(--color-brand);
  }

  .sector-row:hover .sector-arrow {
    color: var(--color-brand);
    transform: translateX(4px);
  }

  @media (min-width: 768px) {
    .sector-row {
      padding-block: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sector-row:hover .sector-arrow {
      transform: none;
    }
  }
</style>
