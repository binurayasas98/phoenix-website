---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import OverlayCard from '../../components/OverlayCard.astro';
import { services } from '../../data/services';
---

<Base
  title="Services | Phoenix Decorators"
  description="Waterproofing, painting, sealants, glass and facade cleaning, industrial coatings and high-rise maintenance for buildings across Sri Lanka."
>
  <PageHero
    title="Our services."
    lead="Six specialist services for commercial, industrial and residential buildings. One team and one contract for every trade."
  />
  <section class="bg-paper pb-[var(--section-y)]" aria-label="All services">
    <ul class="container-site grid gap-4 sm:grid-cols-2 md:gap-5 lg:grid-cols-3">
      {
        services.map((s) => (
          <li>
            <OverlayCard
              image={s.image}
              title={s.name}
              text={s.oneLiner}
              href={`/services/${s.slug}`}
              headingLevel="h2"
              sizes="(min-width: 1024px) 413px, (min-width: 640px) 50vw, 100vw"
            />
          </li>
        ))
      }
    </ul>
  </section>
</Base>
