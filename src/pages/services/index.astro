---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import OverlayCard from '../../components/OverlayCard.astro';
import TextLink from '../../components/TextLink.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/services';
import { labels, site, whatsappUrl } from '../../data/site';
---

<Base
  title="Services | Phoenix Decorators"
  description="Waterproofing, painting, sealants, glass and facade cleaning, industrial coatings and high-rise maintenance for buildings across Sri Lanka."
>
  <PageHero
    title="Our services."
    lead="Six specialist services for commercial, industrial and residential buildings. One team and one contract for every trade."
  />

  <section class="bg-paper pb-[var(--section-y)]" aria-label="All services">
    <div class="container-site flex flex-col gap-16 md:gap-24">
      {
        services.map((s) => (
          <article id={s.slug} class="chapter grid gap-6 md:grid-cols-12 md:items-end md:gap-10">
            <div class="md:col-span-8">
              <OverlayCard
                image={s.image}
                title={s.name}
                text={s.tagline}
                href={`/services/${s.slug}`}
                headingLevel="h2"
                aspect="16 / 9"
                titleClass="t-h2 !text-[clamp(30px,3.6vw,52px)]"
                sizes="(min-width: 1376px) 840px, (min-width: 768px) 64vw, calc(100vw - 48px)"
              />
            </div>
            <div class="md:col-span-4">
              <ul class="border-b border-hairline" aria-label={`${s.name}: scope`}>
                {s.scope.slice(0, 3).map((item) => (
                  <li class="flex gap-3 border-t border-hairline py-3 text-[17px] text-ink">
                    <Icon name="check" size={20} class="mt-[3px] flex-none text-brand" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
              <div class="mt-4 flex flex-col items-start">
                <TextLink href={`/services/${s.slug}`}>Learn more</TextLink>
                <TextLink href={`/quote?service=${s.slug}`}>Get a quote for this service</TextLink>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- A night panel inside a paper section, so it never sits directly against the night CtaBand. -->
  <section class="bg-paper pb-[var(--section-y)]" aria-labelledby="not-sure-heading">
    <div class="container-site">
      <div class="on-night rounded-[var(--radius-card-sm)] bg-night px-6 py-16 text-center text-white md:rounded-[var(--radius-card)] md:px-16 md:py-24" data-track-area="not_sure">
        <h2 id="not-sure-heading" class="t-h2 mx-auto max-w-[16ch] text-balance">Not sure what your building needs?</h2>
        <p class="t-lead mx-auto mt-6 max-w-[40ch] text-white/70">
          Send us a few photos on WhatsApp and a specialist will recommend the right solution.
        </p>
        <a
          href={whatsappUrl(site.whatsappMessages.notSure)}
          target="_blank"
          rel="noopener"
          class="btn btn-lg btn-light mt-10 w-full sm:w-auto"
        >
          <Icon name="whatsapp" size={20} class="text-whatsapp" />
          {labels.whatsapp}
        </a>
      </div>
    </div>
  </section>
</Base>
