---
import { Picture } from 'astro:assets';
import teamImg from '../../assets/images/team.jpg';
import { site } from '../../data/site';
import TwoToneHeading from '../TwoToneHeading.astro';
import Icon from '../Icon.astro';

const numbers = [
  { value: site.projectsCompleted, suffix: '+', label: 'Projects completed since 2011' },
  { text: site.cidaGrade, label: 'CIDA grade for painting and waterproofing' },
  { value: site.warranty.years, suffix: '+', label: 'Year workmanship guarantee' },
];

const statements = [
  { icon: 'shield-check', text: 'Fully insured against third-party claims' },
  { icon: 'flask-conical', text: 'Tested products from brands including Dulux, Conmix and Delta Coatings' },
  { icon: 'users', text: 'Directors and a dedicated supervisor oversee every project' },
] as const;
---

<section class="section bg-mist" aria-labelledby="commitments-heading">
  <div class="container-site">
    <TwoToneHeading id="commitments-heading" first="Quality that lasts." second="Service you can trust." />

    <dl class="mt-14 grid md:mt-20 md:grid-cols-3">
      {
        numbers.map((n) => (
          <div class="stat flex flex-col-reverse justify-end py-8 md:px-10 md:py-2">
            <dt class="mt-3 max-w-[24ch] text-[17px] text-graphite">{n.label}</dt>
            <dd class="stat-number tabular">
              {'value' in n ? (
                <>
                  <span data-count={n.value}>{n.value}</span>
                  {n.suffix}
                </>
              ) : (
                n.text
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="mt-14 grid gap-8 border-t border-hairline pt-10 md:mt-20 md:grid-cols-3 md:gap-10 md:pt-12">
      {
        statements.map((s) => (
          <li class="flex gap-4">
            <Icon name={s.icon} size={28} class="flex-none text-brand" />
            <p class="max-w-[30ch] text-[17px] font-medium leading-snug text-ink">{s.text}</p>
          </li>
        ))
      }
    </ul>

    <figure class="media-reveal relative mt-14 overflow-hidden rounded-[var(--radius-card-sm)] bg-night md:mt-20 md:rounded-[var(--radius-card)]">
      <Picture
        src={teamImg}
        alt="The Phoenix Decorators rope access team in safety harnesses"
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 1376px) 1280px, calc(100vw - 48px)"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] h-auto w-full object-cover md:aspect-[21/9]"
      />
      <div class="overlay-night absolute inset-0" aria-hidden="true"></div>
      <figcaption class="t-h3 absolute bottom-0 left-0 p-6 text-white md:p-10">Our rope access team.</figcaption>
    </figure>
  </div>
</section>

<style>
  .stat-number {
    font-size: clamp(64px, 8vw, 120px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
  }

  .stat + .stat {
    border-top: 1px solid var(--color-hairline);
  }

  .stat:first-child {
    padding-top: 0;
  }

  @media (min-width: 768px) {
    .stat + .stat {
      border-top: 0;
      border-left: 1px solid var(--color-hairline);
    }

    .stat:first-child {
      padding-left: 0;
    }
  }
</style>

<script>
  import { animate, inView } from 'motion';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      el.textContent = '0';

      inView(
        el,
        () => {
          animate(0, target, {
            duration: 1.4,
            ease: [0.22, 1, 0.36, 1],
            onUpdate: (v) => {
              el.textContent = String(Math.round(v));
            },
          });
        },
        { amount: 0.6 },
      );
    });
  }
</script>
