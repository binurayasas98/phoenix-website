---
import { services } from '../../data/services';
import OverlayCard from '../OverlayCard.astro';
import TwoToneHeading from '../TwoToneHeading.astro';
import TextLink from '../TextLink.astro';
import Rail from '../Rail.astro';
---

<section class="section bg-paper" aria-labelledby="services-heading">
  <div class="container-site">
    <TwoToneHeading id="services-heading" first="Six specialist services." second="One accountable team." />
  </div>

  <Rail id="services-rail" label="Services" size="services" class="mt-12 md:mt-16">
    {
      services.map((s) => (
        <li>
          <OverlayCard
            image={s.image}
            title={s.name}
            text={s.oneLiner}
            href={`/services/${s.slug}`}
            sizes="(min-width: 1024px) 400px, (min-width: 768px) 44vw, min(82vw, 360px)"
          />
        </li>
      ))
    }
  </Rail>

  <div class="container-site mt-8">
    <TextLink href="/services">Explore all services</TextLink>
  </div>
</section>
