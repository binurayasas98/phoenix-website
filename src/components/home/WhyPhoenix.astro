---
import { Picture } from 'astro:assets';
import teamImg from '../../assets/images/team.jpg';
import { site } from '../../data/site';
import TwoToneHeading from '../TwoToneHeading.astro';
import Icon from '../Icon.astro';

const numbers = [
  { value: site.projectsCompleted, suffix: '+', label: 'Projects completed since 2011' },
  { text: site.cidaGrade, label: 'CIDA grade for painting and waterproofing' },
  { value: site.warranty.years, suffix: '+', label: 'Year workmanship guarantee' },
];

const reasons = [
  {
    icon: 'users',
    title: 'Directors on every project',
    text: 'Our directors and a dedicated supervisor oversee each job personally.',
  },
  {
    icon: 'clipboard-check',
    title: 'The right system, specified',
    text: 'We assess the site first, then follow manufacturer specifications and industry standards.',
  },
  {
    icon: 'file-check',
    title: 'Written guarantee',
    text: `Up to a ${site.warranty.label}, stated in your quotation.`,
  },
  {
    icon: 'shield-check',
    title: 'Fully insured, CIDA registered',
    text: 'Covered against third-party claims. SP2 for painting and waterproofing.',
  },
  {
    icon: 'hard-hat',
    title: 'Safe at any height',
    text: 'Rope access, gondola, boom truck or scaffolding, with strict safety protocols.',
  },
] as const;
---

<section class="section bg-mist" aria-labelledby="why-heading">
  <div class="container-site">
    <TwoToneHeading id="why-heading" first="Quality that lasts." second="Service you can trust." />

    <dl class="mt-14 grid md:mt-20 md:grid-cols-3">
      {
        numbers.map((n) => (
          <div class="stat flex flex-col-reverse justify-end py-8 md:px-10 md:py-2">
            <dt class="mt-3 max-w-[24ch] text-[17px] text-graphite">{n.label}</dt>
            <dd class="stat-number tabular">
              {'value' in n ? (
                <>
                  <span data-count={n.value}>{n.value}</span>
                  {n.suffix}
                </>
              ) : (
                n.text
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <ul class="reasons mt-14 grid gap-x-8 md:mt-20 md:grid-cols-2 lg:grid-cols-5 lg:gap-x-6">
      {
        reasons.map((r) => (
          <li class="border-t border-hairline py-6 lg:pb-0 lg:pt-8">
            <Icon name={r.icon} size={28} class="text-brand" />
            <h3 class="mt-4 text-[19px] font-semibold leading-snug tracking-[-0.01em] text-ink">{r.title}</h3>
            <p class="mt-2 max-w-[36ch] text-[15px] leading-normal text-graphite">{r.text}</p>
          </li>
        ))
      }
    </ul>

    <figure class="media-reveal relative mt-10 overflow-hidden rounded-[var(--radius-card-sm)] bg-night md:mt-20 md:rounded-[var(--radius-card)]">
      <Picture
        src={teamImg}
        alt="The Phoenix Decorators rope access team in safety harnesses"
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920]}
        sizes="(min-width: 1376px) 1280px, calc(100vw - 48px)"
        loading="lazy"
        decoding="async"
        class="aspect-[4/3] h-auto w-full object-cover md:aspect-[21/9]"
      />
      <div class="overlay-night absolute inset-0" aria-hidden="true"></div>
      <figcaption class="t-h3 absolute bottom-0 left-0 p-6 text-white md:p-10">Our rope access team.</figcaption>
    </figure>
  </div>
</section>

<style>
  .stat-number {
    font-size: clamp(64px, 8vw, 120px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
  }

  .stat + .stat {
    border-top: 1px solid var(--color-hairline);
  }

  .stat:first-child {
    padding-top: 0;
  }

  @media (min-width: 768px) {
    .stat + .stat {
      border-top: 0;
      border-left: 1px solid var(--color-hairline);
    }

    .stat:first-child {
      padding-left: 0;
    }
  }
</style>

<script>
  import { animate, inView } from 'motion';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      el.textContent = '0';

      inView(
        el,
        () => {
          animate(0, target, {
            duration: 1.4,
            ease: [0.22, 1, 0.36, 1],
            onUpdate: (v) => {
              el.textContent = String(Math.round(v));
            },
          });
        },
        { amount: 0.6 },
      );
    });
  }
</script>
