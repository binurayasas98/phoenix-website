---
import { Picture } from 'astro:assets';
import lotusImg from '../../assets/images/brand-lotus-tower.jpg';
import { site } from '../../data/site';
import TwoToneHeading from '../TwoToneHeading.astro';
import Icon from '../Icon.astro';
import MaterialBrands from '../MaterialBrands.astro';

const numbers = [
  { value: site.projectsCompleted, suffix: '+', label: 'Projects completed since 2011' },
  { text: site.cidaGrade, label: 'CIDA grade for painting and waterproofing' },
  { value: site.warranty.waterproofingYears, suffix: '+', label: 'Year guarantee on waterproofing' },
];

const reasons = [
  {
    icon: 'users',
    title: 'Directors on every project',
    text: 'Our directors and a dedicated supervisor oversee each job personally.',
  },
  {
    icon: 'clipboard-check',
    title: 'The right system, specified',
    text: 'We assess the site first, then follow manufacturer specifications and industry standards.',
  },
  {
    icon: 'shield-check',
    title: 'Fully insured',
    text: 'Every project is covered against third-party claims.',
  },
  {
    icon: 'hard-hat',
    title: 'Safe at any height',
    text: 'Rope access, gondola, boom truck or scaffolding, with strict safety protocols.',
  },
] as const;
---

<section class="section bg-mist" aria-labelledby="why-heading">
  <div class="container-site">
    <TwoToneHeading id="why-heading" first="Quality that lasts." second="Service you can trust." />

    <dl class="mt-8 grid grid-cols-3 md:mt-14">
      {
        numbers.map((n) => (
          <div class="stat flex flex-col-reverse justify-end">
            <dt class="stat-label">{n.label}</dt>
            <dd class="stat-number tabular">
              {'value' in n ? (
                <>
                  <span data-count={n.value}>{n.value}</span>
                  {n.suffix}
                </>
              ) : (
                n.text
              )}
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="mt-10 grid items-center gap-6 md:mt-16 md:grid-cols-12 md:gap-10">
      <figure class="md:col-span-5 lg:col-span-4">
        <div class="media-reveal overflow-hidden rounded-[var(--radius-card-sm)] bg-night md:rounded-[var(--radius-card)]">
          <Picture
            src={lotusImg}
            alt="Phoenix technician in a branded shirt with the Lotus Tower behind"
            formats={['avif', 'webp']}
            widths={[400, 640, 960]}
            sizes="(min-width: 1376px) 405px, (min-width: 1024px) 30vw, (min-width: 768px) 40vw, calc(100vw - 48px)"
            loading="lazy"
            decoding="async"
            class="lotus aspect-[4/3] h-auto w-full object-cover md:aspect-[4/5]"
          />
        </div>
        <figcaption class="mt-3 text-[15px] text-graphite">Our team at work in Colombo.</figcaption>
      </figure>

      <ul class="border-b border-hairline md:col-span-7 md:col-start-6 lg:col-span-7 lg:col-start-6">
        {
          reasons.map((r) => (
            <li class="flex gap-4 border-t border-hairline py-4 md:gap-5 md:py-6">
              <Icon name={r.icon} size={28} class="mt-0.5 flex-none text-brand" />
              <div>
                <h3 class="text-[19px] font-semibold leading-snug tracking-[-0.01em] text-ink">{r.title}</h3>
                <p class="mt-1 text-[15px] leading-normal text-graphite md:text-[17px]">{r.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>

    <MaterialBrands size="small" class="mt-10 border-t border-hairline pt-8 md:mt-16 md:pt-12" />
  </div>
</section>

<style>
  .stat-number {
    font-size: clamp(40px, 8vw, 120px);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--color-ink);
  }

  .stat-label {
    margin-top: 10px;
    max-width: 24ch;
    font-size: 13px;
    line-height: 1.35;
    color: var(--color-graphite);
  }

  .stat {
    padding-inline: 12px;
  }

  .stat:first-child {
    padding-left: 0;
  }

  .stat + .stat {
    border-left: 1px solid var(--color-hairline);
  }

  @media (min-width: 768px) {
    .stat {
      padding-inline: 40px;
    }

    .stat-label {
      margin-top: 12px;
      font-size: 17px;
    }
  }

  /* 4:3 on mobile, 4:5 from 768px, never taller than 640px. */
  .lotus {
    max-height: 640px;
    object-position: center 30%;
  }
</style>

<script>
  import { animate, inView } from 'motion';

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduce) {
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const target = Number(el.dataset.count);
      if (!Number.isFinite(target)) return;
      el.textContent = '0';

      inView(
        el,
        () => {
          animate(0, target, {
            duration: 1.4,
            ease: [0.22, 1, 0.36, 1],
            onUpdate: (v) => {
              el.textContent = String(Math.round(v));
            },
          });
        },
        { amount: 0.6 },
      );
    });
  }
</script>
