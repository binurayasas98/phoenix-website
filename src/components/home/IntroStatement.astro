---
const text =
  'Since 2011, facility managers, engineers and building owners have trusted us with more than 350 projects. One specialist team takes responsibility for every job, from the first inspection to the final handover.';
const words = text.split(' ');
---

<section class="section bg-mist" aria-label="About Phoenix Decorators">
  <div class="container-site">
    <p class="intro" data-intro>
      {
        words.map((w) => (
          <>
            <span class="intro-word">{w}</span>{' '}
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .intro {
    font-size: clamp(26px, 3.6vw, 52px);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
    color: var(--color-ink);
    max-width: 22em;
    text-wrap: pretty;
  }

  .intro[data-ready] .intro-word {
    color: rgba(110, 110, 115, 0.35);
    transition: color 300ms var(--ease);
  }

  .intro[data-ready] .intro-word.is-lit {
    color: var(--color-ink);
  }
</style>

<script>
  import { scroll } from 'motion';

  // With reduced motion every word stays in ink; the highlight only runs when motion is allowed.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-intro]').forEach((p) => {
    if (reduce) return;
    p.dataset.ready = '';
    const words = [...p.querySelectorAll<HTMLElement>('.intro-word')];
    let lit = -1;

    scroll(
      (progress: number) => {
        const count = Math.round(progress * words.length);
        if (count === lit) return;
        lit = count;
        words.forEach((w, i) => w.classList.toggle('is-lit', i < count));
      },
      { target: p, offset: ['start 0.6', 'end 0.5'] },
    );
  });
</script>
