---
import { Picture } from 'astro:assets';
import type { Director } from '../data/directors';

// Both directors always share the same crop and size.
// The pull quote and the message read as one quote: one hanging opening mark, the pull quote in ink,
// the message under it in graphite with the closing mark, then the signature.
// "default" (About): portrait column beside a wider text column; set "mirrored" to swap the sides.
// "compact" (home): a small portrait beside the quote. On mobile, a byline row with the quote below.
interface Props {
  director: Director;
  variant?: 'default' | 'compact';
  mirrored?: boolean;
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const { director, variant = 'default', mirrored = false, headingLevel: Heading = 'h3', class: className } = Astro.props;
const headingId = `director-${director.slug}`;
---

{
  variant === 'compact' ? (
    <figure class:list={['director-compact', className]}>
      <div class="dc-photo media-reveal overflow-hidden bg-mist">
        <Picture
          src={director.photo}
          alt={director.alt}
          formats={['avif', 'webp']}
          widths={[176, 264, 352]}
          sizes="(min-width: 1024px) 176px, (min-width: 768px) 144px, 88px"
          width={176}
          height={235}
          loading="lazy"
          decoding="async"
          class="aspect-[3/4] h-auto w-full object-cover object-top"
        />
      </div>
      <blockquote class="dq dq-compact">
        <p class="dq-pull">
          <span class="dq-open" aria-hidden="true">“</span>{director.pullQuote}
        </p>
        <p class="dq-message">
          {director.message}<span aria-hidden="true">”</span>
        </p>
      </blockquote>
      <figcaption class="dc-byline">
        <Heading class="text-[17px] font-semibold leading-snug text-ink">{director.name}</Heading>
        <p class="text-[15px] leading-snug text-graphite">{director.title}</p>
      </figcaption>
    </figure>
  ) : (
    <article
      class:list={['grid items-center gap-8 md:grid-cols-12 md:gap-10', className]}
      aria-labelledby={headingId}
    >
      <div class:list={['md:col-span-4', mirrored && 'md:order-2 md:col-start-9 md:justify-self-end']}>
        <div class="portrait-frame media-reveal overflow-hidden rounded-[var(--radius-card-sm)] bg-mist md:rounded-[var(--radius-card)]">
          <Picture
            src={director.photo}
            alt={director.alt}
            formats={['avif', 'webp']}
            widths={[400, 600, 768]}
            sizes="(min-width: 1024px) 400px, (min-width: 768px) 30vw, 300px"
            width={768}
            height={1024}
            loading="lazy"
            decoding="async"
            class="aspect-[4/5] h-auto w-full object-cover object-top md:aspect-[3/4]"
          />
        </div>
      </div>
      <div class:list={['md:col-span-7', mirrored ? 'md:order-1 md:col-start-1' : 'md:col-start-6']}>
        <blockquote class="dq dq-default">
          <p class="dq-pull">
            <span class="dq-open" aria-hidden="true">“</span>{director.pullQuote}
          </p>
          <p class="dq-message">
            {director.message}<span aria-hidden="true">”</span>
          </p>
        </blockquote>
        <Heading id={headingId} class="mt-8 text-[17px] font-semibold text-ink">
          {director.name}
        </Heading>
        <p class="text-[15px] text-graphite">{director.title}</p>
        {director.note && <p class="mt-6 border-t border-hairline pt-6 text-[17px] font-medium text-ink">{director.note}</p>}
      </div>
    </article>
  )
}

<style>
  /* One continuous quote: pull quote in ink, the message in graphite directly under it. */
  .dq-pull {
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-wrap: balance;
  }

  .dq-message {
    color: var(--color-graphite);
    text-wrap: pretty;
  }

  /* The opening quote mark hangs into the margin so the text keeps a clean left edge. */
  .dq-open {
    display: inline-block;
    width: 0.42em;
    margin-left: -0.42em;
  }

  /* Compact (home): pull quote clamp(20px, 1.8vw, 26px), message 16px on mobile and 17px from tablet. */
  .dq-compact .dq-pull {
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.25;
  }

  .dq-compact .dq-message {
    margin-top: 10px;
    font-size: 16px;
    line-height: 1.55;
  }

  /* Default (About): pull quote clamp(24px, 2.2vw, 32px), message 17px on mobile and 19px from tablet. */
  .dq-default .dq-pull {
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.2;
  }

  .dq-default .dq-message {
    margin-top: 16px;
    font-size: 17px;
    line-height: 1.55;
  }

  @media (min-width: 768px) {
    .dq-compact .dq-message {
      margin-top: 12px;
      font-size: 17px;
    }

    .dq-default .dq-message {
      margin-top: 20px;
      font-size: 19px;
      line-height: 1.5;
    }
  }

  /* Default: portraits stay modest, 4:5 and at most 300px wide on mobile, at most 400px wide on desktop. */
  .portrait-frame {
    max-width: 300px;
  }

  @media (min-width: 768px) {
    .portrait-frame {
      max-width: 400px;
    }
  }

  /* Compact: mobile is a byline row (88px portrait with name and title), then the quote. */
  .director-compact {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    grid-template-areas:
      'photo byline'
      'quote quote';
    column-gap: 16px;
    row-gap: 16px;
    align-items: center;
  }

  .dc-photo {
    grid-area: photo;
    border-radius: 14px;
  }

  .dc-byline {
    grid-area: byline;
  }

  .dq-compact {
    grid-area: quote;
  }

  /* Tablet and up: the portrait sits beside the quote, name and title. */
  @media (min-width: 768px) {
    .director-compact {
      grid-template-columns: 144px minmax(0, 1fr);
      grid-template-areas:
        'photo quote'
        'photo byline';
      grid-template-rows: auto 1fr;
      column-gap: 40px;
      row-gap: 20px;
      align-items: start;
    }

    .dc-photo {
      border-radius: 18px;
    }
  }

  @media (min-width: 1024px) {
    .director-compact {
      grid-template-columns: 176px minmax(0, 1fr);
    }
  }
</style>
