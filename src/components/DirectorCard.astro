---
import { Picture } from 'astro:assets';
import type { Director } from '../data/directors';

// Both directors always share the same crop and size.
// "default": 3:4 portrait, pull quote in large type, then name and title.
// "compact": a small portrait beside the quote (home page). On mobile, a byline row with the quote below.
interface Props {
  director: Director;
  variant?: 'default' | 'compact';
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const { director, variant = 'default', headingLevel: Heading = 'h3', class: className } = Astro.props;
---

{
  variant === 'compact' ? (
    <figure class:list={['director-compact', className]}>
      <div class="dc-photo media-reveal overflow-hidden bg-mist">
        <Picture
          src={director.photo}
          alt={director.alt}
          formats={['avif', 'webp']}
          widths={[176, 264, 352]}
          sizes="(min-width: 1024px) 176px, (min-width: 768px) 144px, 88px"
          width={176}
          height={235}
          loading="lazy"
          decoding="async"
          class="aspect-[3/4] h-auto w-full object-cover object-top"
        />
      </div>
      <blockquote class="dc-quote">
        <p>
          <span class="dc-mark" aria-hidden="true">“</span>{director.pullQuote}<span aria-hidden="true">”</span>
        </p>
      </blockquote>
      <figcaption class="dc-byline">
        <Heading class="text-[17px] font-semibold leading-snug text-ink">{director.name}</Heading>
        <p class="text-[15px] leading-snug text-graphite">{director.title}</p>
      </figcaption>
    </figure>
  ) : (
    <figure class:list={['flex h-full flex-col', className]}>
      <div class="media-reveal overflow-hidden rounded-[var(--radius-card-sm)] bg-mist md:rounded-[var(--radius-card)]">
        <Picture
          src={director.photo}
          alt={director.alt}
          formats={['avif', 'webp']}
          widths={[400, 600, 768]}
          sizes="(min-width: 1376px) 630px, (min-width: 768px) calc(50vw - 58px), calc(100vw - 48px)"
          width={768}
          height={1024}
          loading="lazy"
          decoding="async"
          class="aspect-[3/4] h-auto w-full object-cover object-top"
        />
      </div>
      <blockquote class="mt-8 flex-1 md:mt-10">
        <p class="director-quote text-balance">“{director.pullQuote}”</p>
      </blockquote>
      <figcaption class="mt-6">
        <Heading class="text-[17px] font-semibold text-ink">{director.name}</Heading>
        <p class="text-[15px] text-graphite">{director.title}</p>
      </figcaption>
    </figure>
  )
}

<style>
  .director-quote {
    font-size: clamp(24px, 2.4vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-ink);
  }

  /* Compact: mobile is a byline row (88px portrait with name and title), then the quote. */
  .director-compact {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    grid-template-areas:
      'photo byline'
      'quote quote';
    column-gap: 16px;
    row-gap: 16px;
    align-items: center;
  }

  .dc-photo {
    grid-area: photo;
    border-radius: 14px;
  }

  .dc-byline {
    grid-area: byline;
  }

  .dc-quote {
    grid-area: quote;
  }

  .dc-quote p {
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
    color: var(--color-ink);
    text-wrap: balance;
  }

  /* The opening quote mark hangs into the margin so the text keeps a clean left edge. */
  .dc-mark {
    display: inline-block;
    width: 0.42em;
    margin-left: -0.42em;
  }

  /* Tablet and up: the portrait sits beside the quote, name and title. */
  @media (min-width: 768px) {
    .director-compact {
      grid-template-columns: 144px minmax(0, 1fr);
      grid-template-areas:
        'photo quote'
        'photo byline';
      grid-template-rows: auto 1fr;
      column-gap: 40px;
      row-gap: 20px;
      align-items: start;
    }

    .dc-photo {
      border-radius: 18px;
    }

    .dc-quote p {
      font-size: clamp(22px, 2vw, 28px);
      line-height: 1.25;
    }
  }

  @media (min-width: 1024px) {
    .director-compact {
      grid-template-columns: 176px minmax(0, 1fr);
    }
  }
</style>
