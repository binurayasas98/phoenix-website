---
import { labels, site, whatsappUrl } from '../data/site';
import Icon from './Icon.astro';

interface Props {
  quoteHref?: string;
  whatsappMessage?: string;
}

const { quoteHref = '/quote', whatsappMessage } = Astro.props;


// Closing band on night. Flows straight into the footer.
---

<section class="cta-band on-night bg-night text-white" aria-labelledby="cta-heading" data-track-area="cta_band">
  <div class="container-site pb-24 pt-24 text-center md:pb-32 md:pt-40">
    <h2 id="cta-heading" class="t-h2 mx-auto max-w-[14ch] text-balance">Have a project in mind?</h2>
    <p class="t-lead mx-auto mt-6 max-w-[40ch] text-white/70">
      Book a free consultation and receive a clear, written quotation, with no obligation.
    </p>
    <div class="mt-10 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={quoteHref} class="btn btn-lg btn-light w-full sm:w-auto">{labels.quote}</a>
      <a href={whatsappUrl(whatsappMessage)} target="_blank" rel="noopener" class="btn btn-lg btn-frost w-full sm:w-auto">
        <Icon name="whatsapp" size={20} class="text-whatsapp" />
        {labels.whatsapp}
      </a>
    </div>
    <p class="mt-6">
      <a href={site.phone.href} class="link link-on-night tabular" data-track-location="cta_urgent">
        <span>Urgent leak? Call {site.phone.display}.</span>
      </a>
    </p>
  </div>
</section>
