---
import { Picture } from 'astro:assets';
import type { Photo } from '../data/services';
import { labels, site, whatsappUrl, isAnnouncementActive } from '../data/site';
import Icon from './Icon.astro';
import RopeLine from './RopeLine.astro';
import FactStrip from './FactStrip.astro';

// Full-bleed photo hero. The home page adds the announcement, rope line, fact strip and entrance.
interface Props {
  image: Photo;
  /** CSS object-position for the photo. */
  position?: string;
  /** h1 split into its desktop lines. */
  lines: string[];
  subline: string;
  quoteHref?: string;
  whatsappMessage?: string;
  facts?: string[];
  announcement?: boolean;
  rope?: boolean;
  /** The orchestrated entrance and scroll parallax (home only). */
  entrance?: boolean;
  display?: boolean;
}

const {
  image,
  position = 'center',
  lines,
  subline,
  quoteHref = '/quote',
  whatsappMessage,
  facts = [],
  announcement = false,
  rope = false,
  entrance = false,
  display = true,
} = Astro.props;

const showAnnouncement = announcement && isAnnouncementActive();
---

<section
  class="hero on-photo relative isolate overflow-hidden bg-night text-white"
  data-hero
  data-entrance={entrance ? '' : undefined}
  aria-labelledby="hero-title"
>
  <div class="hero-media absolute inset-0 -z-10" data-hero-media>
    <Picture
      src={image.src}
      alt={image.alt}
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1600, 1920, 2400]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      class="hero-img h-full w-full object-cover"
      style={`object-position: ${position};`}
      data-hero-img
    />
  </div>
  <div class="hero-shade-bottom absolute inset-0 -z-10" aria-hidden="true"></div>
  <div class="hero-shade-left absolute inset-0 -z-10 hidden md:block" aria-hidden="true"></div>
  <div class="hero-shade-top absolute inset-x-0 top-0 -z-10 h-40" aria-hidden="true"></div>
  <div class="absolute inset-0 -z-10 bg-night opacity-0" aria-hidden="true" data-hero-dim></div>

  <div class="container-site flex h-full flex-col pt-[var(--header-h)]">
    <div class="flex min-h-6 flex-1 pb-6">
      {rope && <RopeLine tone="white" dot="light" class="hero-rope h-full -ml-[3.5px]" />}
    </div>

    <div class="pb-10 md:pb-14">
      {
        showAnnouncement && (
          <a
            href={site.announcement.link}
            class="btn-frost hero-fade mb-6 inline-flex min-h-11 items-center rounded-full px-4 py-2 text-[14px] font-medium leading-snug md:mb-8 md:text-[15px]"
            data-announcement
            data-expires={site.announcement.expires}
            data-hero-fade
          >
            <span>
              {site.announcement.text}<span aria-hidden="true">&nbsp;›</span>
            </span>
          </a>
        )
      }

      <h1 id="hero-title" class:list={[display ? 'hero-display' : 't-h1', 'max-w-[14ch] md:max-w-none']}>
        {
          lines.map((line) => (
            <span class="md:block">
              {line.split(' ').map((word) => (
                <>
                  <span class="hero-mask">
                    <span class="hero-word" data-hero-word>
                      {word}
                    </span>
                  </span>{' '}
                </>
              ))}
            </span>
          ))
        }
      </h1>

      <p class="t-lead hero-fade mt-6 max-w-[34ch] text-white/80 md:mt-8 md:max-w-[42ch]" data-hero-fade>
        {subline}
      </p>

      <div class="hero-fade mt-8 flex flex-col gap-3 sm:flex-row md:mt-10" data-hero-fade data-track-area="hero">
        <a href={quoteHref} class="btn btn-lg btn-light">{labels.quote}</a>
        <a
          href={whatsappUrl(whatsappMessage)}
          target="_blank"
          rel="noopener"
          class="btn btn-lg btn-frost"
        >
          <Icon name="whatsapp" size={20} class="text-whatsapp" />
          {labels.whatsapp}
        </a>
      </div>
    </div>

    {
      facts.length > 0 && (
        <div class="hero-fade mb-6 md:mb-8" data-hero-fade>
          <FactStrip facts={facts} tone="night" />
        </div>
      )
    }
  </div>
</section>

<style>
  .hero {
    height: 100svh;
    min-height: 640px;
    max-height: 1080px;
  }

  .hero-display {
    /* Display size, capped on narrow phones so "Waterproofing" never overflows. */
    font-size: min(clamp(56px, 8.5vw, 128px), 11.2vw);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .hero-mask {
    display: inline-block;
    overflow: hidden;
    vertical-align: top;
    /* Room for descenders inside the mask. */
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }

  .hero-word {
    display: inline-block;
  }

  .hero-media :global(img) {
    will-change: transform;
  }

  .hero-shade-bottom {
    background: linear-gradient(to top, rgba(6, 23, 43, 0.85) 0%, rgba(6, 23, 43, 0) 65%);
  }

  .hero-shade-left {
    background: linear-gradient(to right, rgba(6, 23, 43, 0.55) 0%, rgba(6, 23, 43, 0) 55%);
  }

  .hero-shade-top {
    background: linear-gradient(to bottom, rgba(6, 23, 43, 0.4), rgba(6, 23, 43, 0));
  }

  /* Starting states for the entrance. Only when scripts run. */
  :global(html.js) .hero[data-entrance] .hero-img {
    transform: scale(1.1);
  }

  :global(html.js) .hero[data-entrance] .hero-word {
    transform: translateY(110%);
  }

  :global(html.js) .hero[data-entrance] .hero-fade {
    opacity: 0;
  }

  :global(html.js) .hero[data-entrance] .hero-rope :global(.rope-line) {
    transform: scaleY(0);
  }

  :global(html.js) .hero[data-entrance] .hero-rope :global(.rope-dot) {
    opacity: 0;
  }

  /* Failsafe: if the script never runs, show everything after 3 seconds. */
  :global(html.js) .hero[data-entrance] .hero-img,
  :global(html.js) .hero[data-entrance] .hero-word,
  :global(html.js) .hero[data-entrance] .hero-fade,
  :global(html.js) .hero[data-entrance] .hero-rope :global(.rope-line),
  :global(html.js) .hero[data-entrance] .hero-rope :global(.rope-dot) {
    animation: hero-failsafe 1ms linear 3s forwards;
  }

  :global(html.js) .hero[data-entrance].is-animated * {
    animation: none;
  }

  @keyframes hero-failsafe {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero[data-entrance] .hero-img,
    :global(html.js) .hero[data-entrance] .hero-rope :global(.rope-line) {
      transform: none;
    }

    :global(html.js) .hero[data-entrance] .hero-word {
      transform: none;
      opacity: 0;
    }
  }
</style>

<script>
  // Hide the announcement once it has expired, even if the site has not been rebuilt.
  document.querySelectorAll<HTMLElement>('[data-announcement]').forEach((el) => {
    const expires = el.dataset.expires;
    if (expires && Date.now() > new Date(`${expires}T23:59:59+05:30`).getTime()) el.remove();
  });

  const hero = document.querySelector<HTMLElement>('.hero[data-entrance]');
  if (hero) {
    import('../scripts/hero')
      .then(({ runHero }) => runHero(hero))
      .catch(() => hero.removeAttribute('data-entrance'));
  }
</script>
