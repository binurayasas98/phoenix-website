---
import { Image } from 'astro:assets';
import logoWhite from '../assets/images/logo-white.png';
import { labels, site, whatsappUrl, profileEmailUrl } from '../data/site';
import { services } from '../data/services';
import Icon from './Icon.astro';

interface Props {
  quoteHref?: string;
  whatsappMessage?: string;
}

const { quoteHref = '/quote', whatsappMessage } = Astro.props;

const year = new Date().getFullYear();

const company = [
  { label: 'About', href: '/about' },
  { label: 'Sectors', href: '/sectors' },
  { label: 'Projects', href: '/projects' },
  { label: 'Safety and quality', href: '/safety-quality' },
  { label: 'Contact', href: '/contact' },
  { label: 'Common questions', href: '/contact#faq' },
  { label: 'Privacy', href: '/privacy' },
];

const groups = [
  { id: 'services', title: 'Services', links: services.map((s) => ({ label: s.name, href: `/services/${s.slug}` })) },
  { id: 'company', title: 'Company', links: company },
];

const social = [
  { label: 'Facebook', href: site.facebookUrl },
  { label: 'LinkedIn', href: site.linkedinUrl },
  { label: 'Instagram', href: site.instagramUrl },
].filter((s) => s.href);
---

<footer class="on-night bg-night text-white" data-track-area="footer">
  <div class="container-site">
    <div class="border-t border-[var(--hairline-night)] pb-12 pt-12 md:pt-16">
      <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:grid-cols-12 lg:gap-12">
        <div class="col-span-2 lg:col-span-4">
          <a href="/" class="inline-flex h-11 items-center" aria-label={`${site.legalName}, home`}>
            <Image src={logoWhite} alt="" height={80} class="h-10 w-auto" />
          </a>
          <p class="mt-6 text-[17px] font-semibold text-white">Quality that lasts. Service you can trust.</p>
          <p class="mt-3 max-w-[38ch] text-[15px] leading-relaxed text-white/70">
            Waterproofing, painting, sealants, glass cleaning and building maintenance specialists since 2011.
            CIDA SP2 registered and fully insured.
          </p>
          {
            social.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-x-6">
                {social.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener" class="footer-link">
                      {s.label}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <!-- Mobile: Services and Company as collapsible groups, closed by default -->
        <div class="col-span-2 md:hidden">
          {
            groups.map((g) => (
              <details class="footer-group">
                <summary class="footer-summary">
                  <span>{g.title}</span>
                  <Icon name="chevron-down" size={20} class="footer-chevron" />
                </summary>
                <nav aria-label={g.title}>
                  <ul class="pb-3">
                    {g.links.map((l) => (
                      <li><a href={l.href} class="footer-link">{l.label}</a></li>
                    ))}
                  </ul>
                </nav>
              </details>
            ))
          }
        </div>

        {
          groups.map((g, i) => (
            <nav aria-labelledby={`footer-${g.id}`} class:list={['col-span-1 hidden md:block', i === 0 ? 'lg:col-span-3' : 'lg:col-span-2']}>
              <h2 id={`footer-${g.id}`} class="footer-heading">{g.title}</h2>
              <ul class="mt-4">
                {g.links.map((l) => (
                  <li><a href={l.href} class="footer-link">{l.label}</a></li>
                ))}
              </ul>
            </nav>
          ))
        }

        <div class="col-span-2 lg:col-span-3">
          <h2 class="footer-heading">Contact</h2>
          <ul class="mt-4">
            <li><a href={site.phone.href} class="footer-link tabular">{site.phone.display}</a></li>
            <li>
              <a href={whatsappUrl(whatsappMessage)} target="_blank" rel="noopener" class="footer-link">WhatsApp</a>
            </li>
            <li><a href={`mailto:${site.email}`} class="footer-link">{site.email}</a></li>
          </ul>
          <div class="mt-6 space-y-5 text-[15px] leading-relaxed text-white/70">
            <address class="not-italic">
              <span class="block text-white">{site.headOffice.label}</span>
              {site.headOffice.lines.map((l) => <span class="block">{l}</span>)}
            </address>
            <address class="not-italic">
              <span class="block text-white">{site.commercialOffice.label}</span>
              {site.commercialOffice.lines.map((l) => <span class="block">{l}</span>)}
            </address>
            <p class="text-pretty">
              <span class="block">{site.hours}</span>
              <span class="block">{site.hoursNote}</span>
            </p>
          </div>
          <div class="mt-4">
            {
              site.companyProfileUrl ? (
                <a href={site.companyProfileUrl} class="footer-link">
                  <span>Download our company profile</span>
                  <span aria-hidden="true">&nbsp;›</span>
                </a>
              ) : (
                <a href={profileEmailUrl} class="footer-link" data-track-location="footer_profile">
                  <span>Request our company profile</span>
                  <span aria-hidden="true">&nbsp;›</span>
                </a>
              )
            }
          </div>
        </div>
      </div>

      <div class="mt-16 flex flex-col gap-2 border-t border-[var(--hairline-night)] pt-6 text-[13px] text-white/55 md:flex-row md:justify-between">
        <p>© {year} {site.legalName}. All rights reserved.</p>
        <p>CIDA SP2 registered for painting and waterproofing.</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-heading {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
  }

  .footer-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
    line-height: 1.3;
    color: rgba(255, 255, 255, 0.7);
    transition: color 300ms var(--ease);
  }

  .footer-link:hover {
    color: #fff;
  }

  @media (min-width: 1024px) {
    .footer-link {
      min-height: 36px;
    }
  }

  /* Mobile groups: hairline rows with a chevron, like apple.com. */
  .footer-group {
    border-top: 1px solid var(--hairline-night);
  }

  .footer-group:last-child {
    border-bottom: 1px solid var(--hairline-night);
  }

  .footer-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 52px;
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    cursor: pointer;
    list-style: none;
  }

  .footer-summary::-webkit-details-marker {
    display: none;
  }

  .footer-summary :global(.footer-chevron) {
    color: rgba(255, 255, 255, 0.6);
    transition: transform 300ms var(--ease);
  }

  .footer-group[open] :global(.footer-chevron) {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-summary :global(.footer-chevron) {
      transition: none;
    }
  }
</style>
