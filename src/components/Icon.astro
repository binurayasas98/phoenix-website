---
// Lucide icons (ISC licence) drawn inline at a 1.5px stroke, plus the WhatsApp glyph.
interface Props {
  name:
    | 'phone'
    | 'mail'
    | 'menu'
    | 'x'
    | 'plus'
    | 'chevron-left'
    | 'chevron-right'
    | 'chevron-down'
    | 'clipboard-check'
    | 'file-check'
    | 'hard-hat'
    | 'shield-check'
    | 'flask-conical'
    | 'users'
    | 'map-pin'
    | 'clock'
    | 'whatsapp';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className } = Astro.props;

const paths: Record<Exclude<Props['name'], 'whatsapp'>, string> = {
