---
import { Image } from 'astro:assets';
import dulux from '../assets/images/brand-dulux.png';
import conmix from '../assets/images/brand-conmix.png';
import deltaCoatings from '../assets/images/brand-delta-coatings.png';
import ucc from '../assets/images/brand-ucc.png';

// Material brands we work with. They are suppliers, never clients.
// Logos are sized to the same visual weight around a 36px (mobile) and 44px (desktop) base height,
// greyscale at 70% until hovered on desktop. Four in one row on desktop, a 2 x 2 grid on mobile.
interface Props {
  /** "large" for a standalone block (About, Safety and quality), "small" inside a section (home). */
  size?: 'large' | 'small';
  class?: string;
}

const { size = 'large', class: className } = Astro.props;

// scale: height relative to the base, so each logo carries the same optical weight. Wide or dense
// marks sit lower than open, square ones (Delta Coatings is about 4:1, UCC is solid black).
const brands = [
  { src: dulux, alt: 'Dulux', scale: 1 },
  { src: conmix, alt: 'Conmix', scale: 0.92 },
  { src: deltaCoatings, alt: 'Delta Coatings International', scale: 0.72 },
  { src: ucc, alt: 'UCC', scale: 0.74 },
];
---

<div class:list={['brands', className]}>
  <p
    class:list={[
      'text-balance',
      size === 'large' ? 't-h3 text-column text-ink' : 'max-w-[56ch] text-[17px] text-graphite md:text-[19px]',
    ]}
  >
    We work with materials from trusted brands, including Dulux, Conmix, Delta Coatings and UCC.
  </p>
  <ul class="brands-row" aria-label="Material brands">
    {
      brands.map((b) => (
        <li style={`--s: ${b.scale}`}>
          <Image
            src={b.src}
            alt={b.alt}
            height={Math.round(44 * b.scale)}
            densities={[1, 2, 3]}
            quality={90}
            loading="lazy"
            decoding="async"
            class="brand-logo"
          />
        </li>
      ))
    }
  </ul>
</div>

<style>
  .brands-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: center;
    gap: 28px 24px;
    margin-top: 28px;
  }

  .brands-row li {
    display: flex;
    align-items: center;
    height: 36px;
  }

  .brand-logo {
    width: auto;
    height: calc(36px * var(--s, 1));
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 300ms var(--ease),
      opacity 300ms var(--ease);
  }

  @media (min-width: 768px) {
    .brands-row {
      display: flex;
      justify-content: flex-start;
      gap: 64px;
      margin-top: 40px;
    }

    .brands-row li {
      height: 44px;
    }

    .brand-logo {
      height: calc(44px * var(--s, 1));
    }
  }

  @media (hover: hover) and (min-width: 1024px) {
    .brands-row li:hover .brand-logo {
      filter: none;
      opacity: 1;
    }
  }
</style>
